[0:v]scale=1920:1080:flags=lanczos,setsar=1,format=yuv444p,split=2[base][moving];
[moving]pad=1936:1096:8:8:color=black,crop=1920:1080:x='8+1.5*(1-cos(2*PI*n/240))':y='8+0.5*(1-cos(2*PI*n/240))'[shift];
nullsrc=s=1920x1080:r=30:d=8,format=yuv444p,geq=lum='if(between(X,510,695)*between(Y,400,630)+between(X,790,1147)*between(Y,350,680)+between(X,1210,1410)*between(Y,350,645),255,0)':cb=128:cr=128,gblur=sigma=10[mask];
[base][shift][mask]maskedmerge[orbital];
color=c=black:s=18x8:r=30:d=8,format=rgba,geq=r=103:g=223:b=255:a='120*pow(sin(PI*T/8),2)*exp(-pow((X-9)/4,2)-pow((Y-4)/2,2))'[leftflow];
color=c=black:s=18x8:r=30:d=8,format=rgba,geq=r=103:g=223:b=255:a='120*pow(sin(PI*T/8),2)*exp(-pow((X-9)/4,2)-pow((Y-4)/2,2))'[rightflow];
[orbital][leftflow]overlay=x='65+65*t/8':y='768+12*t/8':shortest=1[leftactive];
[leftactive][rightflow]overlay=x='1800+65*t/8':y='778-12*t/8':shortest=1,format=yuv420p[out]
