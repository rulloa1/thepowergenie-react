# ---------------------------------------------------------------------------
# Browser (Vite) — these are PUBLIC values and are safe in the frontend.
# Set them in Vercel → Project → Settings → Environment Variables.
# ---------------------------------------------------------------------------
VITE_SUPABASE_URL=https://ogwiopxnjpwwzleqwobq.supabase.co
# Supabase → Project Settings → API Keys → Publishable key (sb_publishable_…)
VITE_SUPABASE_PUBLISHABLE_KEY=

# ---------------------------------------------------------------------------
# SERVER ONLY — Supabase Edge Function secrets. Never put these in Vercel or
# in any VITE_ variable. Set them with:
#   supabase secrets set --project-ref ogwiopxnjpwwzleqwobq KEY=value
# or Supabase dashboard → Edge Functions → Secrets.
# (SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY are provided automatically.)
# ---------------------------------------------------------------------------
# Google Cloud → APIs & Services → Credentials → OAuth client (Web application)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Public site address, used for redirects after Google sign-in and links in calendar events
SITE_URL=https://your-site.vercel.app
# Optional: only if you change the OAuth redirect URI from the default
# GOOGLE_REDIRECT_URI=https://ogwiopxnjpwwzleqwobq.supabase.co/functions/v1/google-oauth
# Server-only. Do not prefix these with VITE_ — that would ship them to the browser.
# On Vercel, add SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY in Project Settings → Environment Variables.
# The key is the new sb_secret_... format (not a JWT). The server sends it only on the apikey header.

SUPABASE_URL=https://ogwiopxnjpwwzleqwobq.supabase.co
SUPABASE_SERVICE_ROLE_KEY=sb_secret_replace_me

# Optional. Vercel deployments authenticate to AI Gateway with OIDC and can leave this unset.
# Set it for local `npm run dev` when you are not using `vercel env pull`.
AI_GATEWAY_API_KEY=

# Optional. Default model is google/gemini-3.8-flash, which accepts images and PDFs.
AI_GATEWAY_MODEL=google/gemini-3.8-flash

# Optional appointment rules. Defaults: America/Chicago, Mon–Fri 9:00–17:00,
# Saturday 10:00–14:00, 120-minute slots, 14-day horizon, 2-hour minimum lead.
SLOT_TIMEZONE=America/Chicago
SLOT_WEEKDAY_START=9
SLOT_WEEKDAY_END=17
SLOT_SATURDAY_START=10
SLOT_SATURDAY_END=14
SLOT_DURATION_MINUTES=120
SLOT_HORIZON_DAYS=14
SLOT_MIN_LEAD_HOURS=2
SLOT_OPEN_WEEKDAYS=1,2,3,4,5,6

# Test only. Honored solely when SUPABASE_URL points at localhost. Never set this on Vercel.
# ASSISTANT_MOCK_AI=1
# Copy this file to .env.local for local work. On Vercel, add each name in
# Project → Settings → Environment Variables, then redeploy.
#
# Variables that start with VITE_ are copied into the public website at build
# time. Everything else stays on the server. Never put the service role key
# or the Google secret in a VITE_ variable.

# Public site keys (safe to expose in the browser)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Server only
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://thepowergenie.theroyeffect.com/api/google/callback
PUBLIC_SITE_URL=https://thepowergenie.theroyeffect.com
