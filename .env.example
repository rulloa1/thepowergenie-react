# Copy this file to .env.local for local work. On Vercel, add each name in
# Project → Settings → Environment Variables, then redeploy.
#
# Variables that start with VITE_ are copied into the public website at build
# time. Everything else stays on the server. Never put the service role key,
# the Google secret, or an AI Gateway key in a VITE_ variable.

# Public site keys (safe to expose in the browser).
# Both are required for /dashboard sign-in, chat, and files.
# VITE_SUPABASE_URL is also required for a light-bill upload on /book.
# The call itself can be booked with only the server keys below.
VITE_SUPABASE_URL=https://ogwiopxnjpwwzleqwobq.supabase.co
VITE_SUPABASE_ANON_KEY=

# Server only. Required for /book, the dashboard API, and the website assistant.
# SUPABASE_URL may match VITE_SUPABASE_URL. The service role key is a secret.
# The assistant accepts the sb_secret_... key on the apikey header only.
# The dashboard client also sends that key the way supabase-js does, which
# expects the JWT service_role key. Use the key this Supabase project issued.
SUPABASE_URL=https://ogwiopxnjpwwzleqwobq.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Optional. Required only to connect Horace's Google Calendar. Booking and the
# dashboard still run without them. Horace's phone events will not block times,
# and new bookings will not be pushed to his calendar, until all four are set.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://thepowergenie.theroyeffect.com/api/google/callback
PUBLIC_SITE_URL=https://thepowergenie.theroyeffect.com

# Optional. Vercel deployments authenticate to AI Gateway with OIDC and can leave this unset.
# Set it for local `bun run dev` when you are not using `vercel env pull`.
AI_GATEWAY_API_KEY=

# Optional. Default model is google/gemini-3.8-flash, which accepts images and PDFs.
AI_GATEWAY_MODEL=google/gemini-3.8-flash

# Optional assistant appointment rules. Defaults: America/Chicago, Mon–Fri 9:00–17:00,
# Saturday 10:00–14:00, 120-minute slots, 14-day horizon, 2-hour minimum lead.
# The public /book page uses its own weekday 1-hour rules and is not changed by these.
SLOT_TIMEZONE=America/Chicago
SLOT_WEEKDAY_START=9
SLOT_WEEKDAY_END=17
SLOT_SATURDAY_START=10
SLOT_SATURDAY_END=14
SLOT_DURATION_MINUTES=120
SLOT_HORIZON_DAYS=14
SLOT_MIN_LEAD_HOURS=2
SLOT_OPEN_WEEKDAYS=1,2,3,4,5,6

# Test only. Honored solely when SUPABASE_URL points at localhost. Never set this on Vercel.
# ASSISTANT_MOCK_AI=1
