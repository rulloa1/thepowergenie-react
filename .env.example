# Copy to .env.local for local work. On Vercel, add each name under
# Project → Settings → Environment Variables, then redeploy.
# Names that start with VITE_ are copied into the public site at build time.
# Never put a service role key, Google secret, or AI Gateway key in a VITE_ name.
#
# Supabase project: ogwiopxnjpwwzleqwobq
# https://ogwiopxnjpwwzleqwobq.supabase.co

# Public. Referral Hub (/book, /dashboard) and the marketing site.
# The hub client uses the publishable key when it is set, and the anon key otherwise.
VITE_SUPABASE_URL=https://ogwiopxnjpwwzleqwobq.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_ANON_KEY=

# Server only. Required for the website assistant (api/assistant).
# The assistant sends sb_secret_... on the apikey header only.
# A legacy service_role JWT is also accepted on apikey. Never send it as Authorization.
SUPABASE_URL=https://ogwiopxnjpwwzleqwobq.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Referral Hub Edge Functions. Set these as Supabase function secrets
# (supabase secrets set --project-ref ogwiopxnjpwwzleqwobq), not as VITE_ vars.
# SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY are injected for hosted functions.
# SB_SECRET_KEY is an optional alias for the service-role key on the new key system.
# Google secrets are optional until Horace connects Google Calendar.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Where google-oauth sends the browser after Calendar connect.
# The booking function also POSTs to SITE_URL/api/assistant?route=extract
# so /book can run the same bill extractor. Defaults to the production URL.
SITE_URL=https://thepowergenie.theroyeffect.com
# Shared by Vercel (api/assistant) and the booking Edge Function. Required for
# /book bill reading: Supabase injects its own SUPABASE_SERVICE_ROLE_KEY and
# will not let a secret override a SUPABASE_ name, so this name must not start
# with SUPABASE_. Set the same long random value on Vercel (Production, and
# Preview if preview bookings should read bills) and as a Supabase function
# secret, then redeploy the booking function. The route still accepts
# SUPABASE_SERVICE_ROLE_KEY when that key matches, and it stays closed with
# neither secret. Do not use a VITE_ name.
EXTRACT_SHARED_SECRET=
# Optional. Defaults to https://ogwiopxnjpwwzleqwobq.supabase.co/functions/v1/google-oauth
# GOOGLE_REDIRECT_URI=https://ogwiopxnjpwwzleqwobq.supabase.co/functions/v1/google-oauth

# Optional. Vercel AI Gateway uses OIDC. Set this only for local dev.
AI_GATEWAY_API_KEY=
# Optional. Default is google/gemini-2.5-flash-lite, which the free-tier
# AI Gateway can call and which reads bill images and PDFs.
AI_GATEWAY_MODEL=google/gemini-2.5-flash-lite

# Optional assistant consult windows. Defaults: America/Chicago, Mon–Fri 9–17,
# Saturday 10–14, 120 minutes, 14 days, 2-hour lead.
# Set SLOT_DURATION_MINUTES on the booking and schedule Edge Functions too,
# when it is not 120. /book treats each website consult as busy for that long.
SLOT_TIMEZONE=America/Chicago
SLOT_WEEKDAY_START=9
SLOT_WEEKDAY_END=17
SLOT_SATURDAY_START=10
SLOT_SATURDAY_END=14
SLOT_DURATION_MINUTES=120
SLOT_HORIZON_DAYS=14
SLOT_MIN_LEAD_HOURS=2
SLOT_OPEN_WEEKDAYS=1,2,3,4,5,6

# Test only. Honored solely when SUPABASE_URL points at localhost. Never set this on Vercel.
# ASSISTANT_MOCK_AI=1

# Optional instant alerts for a new website lead or a /book consult.
# Each channel is skipped when its variables are missing. Use the same names
# on Vercel and as Supabase secrets for the booking function.
# NOTIFY_EMAIL_TO and NOTIFY_SMS_TO are comma-separated. SMS numbers are E.164.
RESEND_API_KEY=
NOTIFY_FROM=
NOTIFY_EMAIL_TO=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
NOTIFY_SMS_TO=

# Smart Meter Texas. Server only. Leave these blank until the portal login
# exists. /book then saves the ESI ID, meter number, and consent as
# pending_setup and does not call Smart Meter Texas. The daily cron at
# /api/smt/refresh requests the agreement and stores usage once these are set.
# Set the same SMT_* names as Supabase secrets for any function that reads them,
# and on Vercel for the cron. Do not use a VITE_ name.
SMT_USERNAME=
SMT_PASSWORD=
SMT_REQUESTOR_ID=
SMT_DUNS=
# Optional token from the post-September 2025 portal guide. Sent as
# Authorization: Bearer. Do not invent a token URL.
SMT_API_TOKEN=
# Optional PEM pair. Both must be set before a client certificate is attached.
# Newlines may be written as \n.
SMT_CLIENT_CERT=
SMT_CLIENT_KEY=
# Optional. Defaults to https://services.smartmetertexas.net
SMT_API_BASE=
# Required before /api/smt/refresh will run. Vercel Cron sends it as
# Authorization: Bearer.
CRON_SECRET=

# Conference rooms (LiveKit Cloud). Server only, on Vercel → Settings →
# Environment Variables → Production (and Preview if preview calls should work).
# Do not set these as Supabase secrets and do not use a VITE_ name.
# LIVEKIT_URL is the public WebSocket address, not a secret. It defaults to
# the project below when unset. LIVEKIT_API_KEY and LIVEKIT_API_SECRET come
# from LiveKit Cloud → Settings → Keys. The secret never goes in the browser.
LIVEKIT_URL=wss://thepowergenie-conference-room-m4nzqnpy.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
