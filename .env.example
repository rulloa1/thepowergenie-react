# Copy to .env.local for local work. On Vercel, add each name under
# Project → Settings → Environment Variables, then redeploy.
# Names that start with VITE_ are copied into the public site at build time.
# Never put a service role key, Google secret, or AI Gateway key in a VITE_ name.

# Public. Same Supabase project URL for the marketing site, the Referral Hub,
# and the earlier Vercel booking pages.
VITE_SUPABASE_URL=https://ogwiopxnjpwwzleqwobq.supabase.co
# Referral Hub prefers the publishable key. The earlier dashboard accepts the anon key.
# Hub code uses the publishable key when it is set, and the anon key otherwise.
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_ANON_KEY=

# Server only. Required for the website assistant and for /api booking routes
# (/api/availability, /api/book, and the owner dashboard API).
# The assistant sends sb_secret_... on the apikey header only.
SUPABASE_URL=https://ogwiopxnjpwwzleqwobq.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Referral Hub Edge Functions. Set these as Supabase function secrets
# (supabase secrets set --project-ref ogwiopxnjpwwzleqwobq), not as VITE_ vars.
# Optional until Horace connects Google Calendar on the hub.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
SITE_URL=https://thepowergenie.theroyeffect.com
# GOOGLE_REDIRECT_URI=https://ogwiopxnjpwwzleqwobq.supabase.co/functions/v1/google-oauth

# Earlier Vercel /api/google routes. Optional, and only used by /node/dashboard.
# All four must be set together. Booking still saves without them.
GOOGLE_REDIRECT_URI=https://thepowergenie.theroyeffect.com/api/google/callback
PUBLIC_SITE_URL=https://thepowergenie.theroyeffect.com

# Optional. Vercel AI Gateway uses OIDC. Set this only for local dev.
AI_GATEWAY_API_KEY=
# Optional. Default is google/gemini-3.8-flash.
AI_GATEWAY_MODEL=google/gemini-3.8-flash

# Optional assistant consult windows. Defaults: America/Chicago, Mon–Fri 9–17,
# Saturday 10–14, 120 minutes, 14 days, 2-hour lead. The /book page does not use these.
SLOT_TIMEZONE=America/Chicago
SLOT_WEEKDAY_START=9
SLOT_WEEKDAY_END=17
SLOT_SATURDAY_START=10
SLOT_SATURDAY_END=14
SLOT_DURATION_MINUTES=120
SLOT_HORIZON_DAYS=14
SLOT_MIN_LEAD_HOURS=2
SLOT_OPEN_WEEKDAYS=1,2,3,4,5,6

# Test only. Honored solely when SUPABASE_URL points at localhost. Never set this on Vercel.
# ASSISTANT_MOCK_AI=1
