  "narrative": {
    "northStar": "Power Genie application workspace",
    "overview": "This is a descriptive name for the inherited application world in the approved Video Studio direction contract. Navy fields, ice-blue controls, warm gold focus, and restrained borders connect the new editor with the Referral Hub. This record captures the existing application foundation and the shipped Video Studio extension; it does not replace the public marketing journey, booking-page overrides, assistant brand variants, or individual product identities.\n\nThe studio is a compact editing workspace. Its own stylesheet and entry point preserve the inherited color roles while using local surface colors and denser controls. Those local measurements apply to Video Studio, rather than redefining the hub's shared components.",
    "keyCharacteristics": [
      "Navy surfaces with ice-blue primary actions.",
      "Gold keyboard focus and visible selection treatments.",
      "Restrained borders, modest rounding, and flat studio panels.",
      "Denser studio controls alongside larger hub controls."
    ],
    "rules": [
      {
        "name": "Inherited Roles",
        "body": "Preserve the hub's color roles when extending shared hub components; keep Video Studio's local surface and density variations scoped to its entry point.",
        "section": "colors"
      },
      {
        "name": "Visible State",
        "body": "Selected tabs have an underline, selected scene cards have an outline and changed label fill, and focus has a gold outline. Preserve these non-color state cues.",
        "section": "colors"
      }
    ],
    "dos": [
      "Do preserve inherited hub color roles and scope studio surface variations to Video Studio.",
      "Do retain visible outlines, underlines, and fill changes for keyboard focus and selection.",
      "Do preserve the studio's mobile links between the selected scene editor and full preview.",
      "Do keep the solar example labeled as existing Power Genie imagery."
    ],
    "donts": [
      "Don't apply the studio's smaller controls or local surface colors globally to the hub.",
      "Don't merge or remove the separate Celebrity Solar, Hip-Hop Solar, and Gas-Genie navigation.",
      "Don't turn local pipeline tints or media aspect ratios into brand-wide rules."
    ]
  }
}
