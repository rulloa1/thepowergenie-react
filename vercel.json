{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    {
      "source": "/node/book",
      "destination": "/book",
      "permanent": true
    },
    {
      "source": "/node/book/",
      "destination": "/book",
      "permanent": true
    },
    {
      "source": "/node/dashboard",
      "destination": "/dashboard",
      "permanent": true
    },
    {
      "source": "/node/dashboard/",
      "destination": "/dashboard",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/((?!api(?:/|$)|assets(?:/|$)|assets-v2(?:/|$)|brand-lockups(?:/|$)|privacy(?:/|$|\\.html$)|terms(?:/|$|\\.html$)|paused\\.html$).*)",
      "destination": "/paused.html"
    },
    {
      "source": "/api/(chat|uploads|bill|lead|slots|visit|invite)",
      "destination": "/api/assistant?route=$1"
    },
    {
      "source": "/proposal/:token/interested",
      "destination": "/paused.html"
    },
    {
      "source": "/proposal/:token",
      "destination": "/paused.html"
    },
    {
      "source": "/privacy",
      "destination": "/privacy.html"
    },
    {
      "source": "/privacy/",
      "destination": "/privacy.html"
    },
    {
      "source": "/terms",
      "destination": "/terms.html"
    },
    {
      "source": "/terms/",
      "destination": "/terms.html"
    },
    {
      "source": "/launch/gas-genie",
      "destination": "/paused.html"
    },
    {
      "source": "/launch/celebrity-solar",
      "destination": "/paused.html"
    },
    {
      "source": "/launch/hip-hop-solar",
      "destination": "/paused.html"
    },
    {
      "source": "/launch/sport-and-solar",
      "destination": "/paused.html"
    },
    {
      "source": "/sport-and-solar",
      "destination": "/paused.html"
    },
    {
      "source": "/((?!api/|brand-lockups(?:/|$)).*)",
      "destination": "/paused.html"
    }
  ],
  "headers": [
    {
      "source": "/(dashboard|pipeline|hub|homeowner|portal|referrals)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    }
  ],
  "crons": [
    {
      "path": "/api/smt/refresh",
      "schedule": "0 13 * * *"
    }
  ]
}
