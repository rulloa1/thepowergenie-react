{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    { "source": "/book", "destination": "/index.html" },
    { "source": "/dashboard", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/dashboard",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }]
    }
  "rewrites": [
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
