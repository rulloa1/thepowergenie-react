{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    { "source": "/node/book", "destination": "/book", "permanent": true },
    { "source": "/node/book/", "destination": "/book", "permanent": true },
    { "source": "/node/dashboard", "destination": "/dashboard", "permanent": true },
    { "source": "/node/dashboard/", "destination": "/dashboard", "permanent": true }
  ],
  "rewrites": [
    {
      "source": "/api/(chat|uploads|bill|lead|slots|visit|invite)",
      "destination": "/api/assistant?route=$1"
    },
    {
      "source": "/proposal/:token/interested",
      "destination": "/api/assistant?route=proposal&t=:token&action=interested"
    },
    {
      "source": "/proposal/:token",
      "destination": "/api/assistant?route=proposal&t=:token"
    },
    {
      "source": "/privacy",
      "destination": "/privacy.html"
    },
    {
      "source": "/privacy/",
      "destination": "/privacy.html"
    },
    {
      "source": "/terms",
      "destination": "/terms.html"
    },
    {
      "source": "/terms/",
      "destination": "/terms.html"
    },
    {
      "source": "/((?!api/|brand-lockups(?:/|$)).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(dashboard|pipeline|hub|homeowner|portal|referrals)",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }]
    }
  ],
  "crons": [
    { "path": "/api/smt/refresh", "schedule": "0 13 * * *" }
  ]
}
