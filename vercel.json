{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    {
      "source": "/node/book",
      "destination": "/book",
      "permanent": true
    },
    {
      "source": "/node/book/",
      "destination": "/book",
      "permanent": true
    },
    {
      "source": "/node/dashboard",
      "destination": "/dashboard",
      "permanent": true
    },
    {
      "source": "/node/dashboard/",
      "destination": "/dashboard",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/api/(chat|uploads|bill|lead|slots|visit|invite)",
      "destination": "/api/assistant?route=$1"
    },
    {
      "source": "/proposal/:token/interested",
      "destination": "/api/assistant?route=proposal&t=:token&action=interested"
    },
    {
      "source": "/proposal/:token",
      "destination": "/api/assistant?route=proposal&t=:token"
    },
    {
      "source": "/privacy",
      "destination": "/privacy.html"
    },
    {
      "source": "/privacy/",
      "destination": "/privacy.html"
    },
    {
      "source": "/terms",
      "destination": "/terms.html"
    },
    {
      "source": "/terms/",
      "destination": "/terms.html"
    },
    {
      "source": "/launch/gas-genie",
      "destination": "/gas-genie.html"
    },
    {
      "source": "/launch/celebrity-solar",
      "destination": "/celebrity-solar.html"
    },
    {
      "source": "/launch/hip-hop-solar",
      "destination": "/hip-hop-solar.html"
    },
    {
      "source": "/launch/sport-and-solar",
      "destination": "/sport-and-solar.html"
    },
    {
      "source": "/sport-and-solar",
      "destination": "/sport-and-solar.html"
    },
    {
      "source": "/assets/bills",
      "destination": "/api/not-found"
    },
    {
      "source": "/assets/bills/:path*",
      "destination": "/api/not-found"
    },
    {
      "source": "/assets/plans",
      "destination": "/api/not-found"
    },
    {
      "source": "/assets/plans/:path*",
      "destination": "/api/not-found"
    },
    {
      "source": "/((?!api/|brand-lockups(?:/|$)|assets/bills(?:/|$)|assets/plans(?:/|$)).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(dashboard|pipeline|hub|homeowner|portal|referrals)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    }
  ],
  "crons": [
    {
      "path": "/api/smt/refresh",
      "schedule": "0 13 * * *"
    }
  ]
}
