{
  "name": "power-genie",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 3000",
    "build": "tsc -p tsconfig.json && tsc -p tsconfig.server.json && tsc -p api/tsconfig.json && vite build && tsx scripts/prerender-legal.ts",
    "test": "vitest run && tsx --test tests/*.test.ts",
    "lint": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.server.json --noEmit && tsc -p api/tsconfig.json --noEmit",
    "preview": "vite preview"
  },
  "dependencies": {
    "@livekit/track-processors": "0.8.3",
    "@ai-sdk/react": "^4.0.152",
    "@livekit/components-react": "^2.9.25",
    "@livekit/components-styles": "^1.2.0",
    "@supabase/supabase-js": "^2.118.0",
    "@tailwindcss/vite": "^4.3.3",
    "@vercel/analytics": "^2.0.1",
    "ai": "^7.0.148",
    "clsx": "^2.1.1",
    "heic-convert": "^2.1.0",
    "livekit-client": "^2.24.1",
    "livekit-server-sdk": "^2.19.3",
    "lucide-react": "^0.446.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^2.5.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "^18.3.10",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.2",
    "autoprefixer": "^10.4.20",
    "playwright": "^1.55.1",
    "postcss": "^8.4.47",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.20.6",
    "typescript": "^5.6.2",
    "vite": "^8.3.5",
    "vitest": "^3.2.7"
  }
}
