{
  "name": "power-genie",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 3000",
    "build": "tsc -p tsconfig.json && tsc -p tsconfig.server.json && tsc -p api/tsconfig.json && vite build && tsx scripts/prerender-legal.ts",
    "test": "vitest run && tsx --test tests/*.test.ts",
